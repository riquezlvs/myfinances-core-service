# ============================================================================
# MyFinances — Variáveis de ambiente (nunca commitar o .env real)
# Copie este arquivo para .env e preencha com seus valores.
# ============================================================================

# Token do Bot do Telegram (obtido com @BotFather)
TELEGRAM_BOT_TOKEN=

# Seu ID de usuário do Telegram (número, sem aspas) — somente este usuário
# pode usar o bot. Obtenha com @userinfobot.
TELEGRAM_AUTHORIZED_USER_ID=

# API Key do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# URL do projeto Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL=

# Service Role Key do Supabase (Settings → API → Service Role).
# NUNCA compartilhe ou exponha em cliente/browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Opcionais (descomente e ajuste conforme necessário)
# ============================================================================

# Opcional: modelo do Gemini a usar (padrão: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Opcional: nível de log (debug | info | warn | error)
# LOG_LEVEL=info

# Opcional: rate limiting — mensagens por minuto por usuário (padrão: 30)
# RATE_LIMIT_CAP=30
# RATE_LIMIT_REFILL_PER_MIN=30

# Opcional: habilitar cache de câmbio no Supabase (padrão: false)
# EXCHANGE_CACHE_ENABLED=false

# Opcional: timeout para APIs externas em ms (padrão: 5000)
# EXTERNAL_API_TIMEOUT_MS=5000

# ── Identidade do Bot (Opcional) ─────────────────────────────────────────
# Nome exibido do bot no Telegram (padrão: "Guará IA")
# BOT_NAME=Guará IA

# Caminho LOCAL ou URL da foto de perfil do bot (JPEG/PNG, ≤ 512KB).
# - Local:  /caminho/completo/para/foto.jpg
# - URL:    https://exemplo.com/foto.jpg
# Opcional — quando ausente, a foto não é atualizada na inicialização.
# BOT_PROFILE_PHOTO_PATH=/caminho/para/foto.jpg