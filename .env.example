# ============================================================================
# MyFinances — Variáveis de ambiente (nunca commitar o .env real)
# Copie este arquivo para .env e preencha com seus valores.
# ============================================================================

# Token do Bot do Telegram (obtido com @BotFather)
TELEGRAM_BOT_TOKEN=

# Seu ID de usuário do Telegram (número, sem aspas) — somente este usuário
# pode usar o bot. Obtenha com @userinfobot.
TELEGRAM_AUTHORIZED_USER_ID=

# API Key do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# URL do projeto Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL=

# Service Role Key do Supabase (Settings → API → Service Role).
# NUNCA compartilhe ou exponha em cliente/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: modelo do Gemini a usar (padrão definido em src/config/constants.ts)
# GEMINI_MODEL=gemini-2.5-flash

# Opcional: nível de log (debug | info | warn | error)
# LOG_LEVEL=info