{
  "name": "telegram-financeiro-bot",
  "version": "2.0.0",
  "description": "Bot Telegram + Gemini + Supabase para registro de gastos pessoais",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup-bot": "tsx scripts/configure-bot.ts",
    "avatar": "node scripts/gerar-avatar-bot.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@napi-rs/canvas": "^1.0.8",
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.7",
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^0.66.0",
    "typescript": "^7.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "vitest": "^2.1.0"
  }
}
